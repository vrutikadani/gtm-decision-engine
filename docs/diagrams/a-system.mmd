flowchart TB
  JC["Job-change webhooks<br/>2 vendor payload shapes"] --> N["Normalization<br/>vendor payload to one JobChange"]
  N --> DD["Dedupe<br/>event id + same move within 14 days"]
  DD --> ID
  subgraph DE["Decision engine: rules + trace (gde/decisions/engine.py)"]
    ID["Identity + event-order watermark"] --> CH["Champion evidence"]
    CH --> CX["Account context<br/>source precedence per field"]
    CX --> Q["Qualification + seller suppressions"]
    Q --> CI["Conversation intent<br/>model labels, code validates and decides"]
    CI --> PR["Approved play registry"]
  end
  EV["Champion evidence rows (fixture)<br/>warehouse usage, CRM, Gong, field notes"] --> CH
  CRM["CRM accounts + opportunities (fixture)<br/>simulated adapter"] --> CX
  ENR["Enrichment (fixture)<br/>simulated adapter, cache on timeout"] --> CX
  CONV["Conversations (fixture)<br/>Gong transcripts + field notes"] --> CI
  CONV --> BE["GTM brief engine<br/>mentions + citations"]
  BE --> BP["Brief page (separate output)"]
  PR --> OB["Outbox + worker<br/>retry, cap, dead letter"]
  OB --> SL["Slack card (simulated)<br/>edited in place on correction"]
  SL --> FB["Seller feedback"]
  FB -- "accept, correct" --> OB
  OB --> W["CRM write-back / compensation (simulated)"]
  FB -. "future decisions" .-> DE
  classDef rule fill:#e8edfd,stroke:#3b5bdb,color:#1d2330
  classDef ext fill:#f0f2f5,stroke:#9aa3b2,color:#1d2330
  classDef fixture fill:#fff8e6,stroke:#c69214,color:#1d2330,stroke-dasharray: 4 3
  class N,DD,ID,CH,CX,Q,CI,PR,BE,OB rule
  class JC,SL,W,FB,BP ext
  class EV,CRM,ENR,CONV fixture
